<Project>
  <!-- The shared settings come from the repository root; this file holds only what a TEST project differs
       on. It used to be a copy of src/, version included, which is the duplication `doctor` now refuses. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is public API, so nothing here needs XML docs. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Test helpers every project needs, compiled into each rather than copied into each. The alternative
       was three identical copies of the same twelve lines, one per test assembly. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared\*.cs" LinkBase="Shared" />
    <Using Include="Tyanor.Tests.Support" />
  </ItemGroup>

  <!-- Where the repository is, for the tests that read files that are part of the SOURCE rather than part of
       a fixture — the API baselines. Stamped at build time rather than discovered by walking up from the
       output directory, which is the usual trick and breaks as soon as anything runs the assembly from
       somewhere else. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
