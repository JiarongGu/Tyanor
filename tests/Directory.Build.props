<Project>
  <!-- The shared settings come from the repository root; this file holds only what a TEST project differs
       on. It used to be a copy of src/, version included, which is the duplication `doctor` now refuses. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is public API, so nothing here needs XML docs. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Test helpers every project needs, compiled into each rather than copied into each. The alternative
       was three identical copies of the same twelve lines, one per test assembly. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared\*.cs" LinkBase="Shared" />
    <Using Include="Tyanor.Tests.Support" />
  </ItemGroup>
</Project>
