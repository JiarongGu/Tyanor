<Project>
  <!-- The shared settings, including the single VersionPrefix, come from the repository root. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Package metadata: everything under src/ ships to NuGet. Per-project Description lives in the csproj,
       because that is the one line that genuinely differs between them. -->
  <PropertyGroup>
    <Authors>Jiarong Gu</Authors>
    <Product>Tyanor</Product>
    <Company>Jiarong Gu</Company>
    <Copyright>Copyright (c) Jiarong Gu</Copyright>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JiarongGu/Tyanor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JiarongGu/Tyanor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>deployment;operations;devops;infrastructure;reconcile;terraform;local-first</PackageTags>

    <!-- The README travels with the package: someone reading it on nuget.org is exactly the person who has
         not yet decided to clone the repository. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols, so a consumer stepping into a paused deployment can see why it paused. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- …and SourceLink, so those symbols can FETCH the source they point at. Without it a .snupkg leads a
         debugger to an absolute path that existed only on the machine that built the package, which is most
         of the way to useless — and this library's value is largely in the comments explaining WHY a line is
         there, which a consumer only reaches by stepping into it. Built into the SDK since .NET 8, so this
         costs no PackageReference and leaves the dependency budget alone. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Deterministic source paths, on CI only. It rewrites paths to placeholders, which is exactly right for
         a published package and exactly wrong while debugging locally. GitHub Actions sets CI=true. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
