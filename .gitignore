bin/
obj/
artifacts/
*.user
.vs/
.idea/
TestResults/
.claude/settings.local.json

# What an API baseline test writes when it fails, so the fix is a copy rather than a transcription from a
# test log. Never committed — the baseline beside it is the file under review.
tests/ApiBaselines/*.actual

# Credentials, kept out by construction rather than by the `sensitive` scan noticing them. This repo's
# live tests take real AWS keys from the environment (TYANOR_LIVE_AWS), so a .env beside them is the
# obvious convenience and the obvious way to publish a key permanently. The scan is the second line:
# it reads by extension, and none of these have one it would match.
.env
.env.*
*.pem
*.pfx
*.p12
credentials
